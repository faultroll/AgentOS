# AgentOS Distributed Memory (OS Global & Autonomous Apps)
# Ignore runtime files inside memory directories but PRESERVE the directory structure and .gitkeep
**/memory/**/facts/*
**/memory/**/summaries/*
**/memory/**/preferences/*
!**/memory/**/facts/.gitkeep
!**/memory/**/summaries/.gitkeep
!**/memory/**/preferences/.gitkeep

# Ignore loose txt/db files globally in memory sandboxes
**/memory/**/*.db
**/memory/**/*.tmp