{
  "$schema": "https://app.kilo.ai/config.json",
  "formatter": false,
  "permission": {
    "bash": "allow"
  },
  "lsp": false,
  "share": "disabled",
  "disabled_providers": [],
  "provider": {
    "local": {
      "name": "local",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1/"
      },
      "models": {
        "1": {
          "name": "1",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text",
              "image"
            ],
          }
        }
      }
    }
  },
  "default_agent": "plan",
}